# Скопіюйте в .env.prod НА СЕРВЕРІ й заповніть. Файл .env.prod НЕ можна комітити в git
# (додайте рядок `.env.prod` у .gitignore).

# Домен API (DNS A-запис має вести на IP сервера)
API_DOMAIN=api.example.com

# Пароль Postgres. Лише літери й цифри (він іде в URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Ключ підпису токенів. Обов'язково свій: openssl rand -hex 32
JWT_SECRET_KEY=

# Публічна адреса API: за нею будуються посилання на завантажені картинки
MEDIA_PUBLIC_BASE_URL=https://api.example.com

# Дозволені origin'и. Значення в одинарних лапках, усередині JSON.
# tauri://localhost і http(s)://tauri.localhost — для десктопного застосунку Tauri
# (точний origin перевірте в DevTools -> Network -> заголовок Origin).
CORS_ORIGINS='["https://bytenews.example.com","tauri://localhost","http://tauri.localhost","https://tauri.localhost"]'

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RSS_INTERVAL_MINUTES=10

# Джерела RSS (JSON, в одинарних лапках). Скопіюйте з .env.example або змініть.
RSS_SOURCES='[{"name":"Ars Technica","feed_url":"https://feeds.arstechnica.com/arstechnica/index","category_slug":"development"},{"name":"BleepingComputer","feed_url":"https://www.bleepingcomputer.com/feed/","category_slug":"cybersecurity"},{"name":"DOU","feed_url":"https://dou.ua/feed/","category_slug":"development"}]'
